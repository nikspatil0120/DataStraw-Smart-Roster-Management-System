# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/datastraw

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# JWT Configuration (for future auth)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Scheduler Configuration
SCHEDULER_TIMEOUT_SECONDS=60
SCHEDULER_FALLBACK_ENABLED=True

# Export Configuration
EXPORT_FORMAT_DEFAULT=csv
EXPORT_PATH=/tmp/exports

# Feature Flags
ENABLE_CONFLICT_AUTO_RESOLUTION=False
ENABLE_FAIR_WEEKLY_OFF_DISTRIBUTION=False
ENABLE_PREFERENCE_BASED_SCHEDULING=False
